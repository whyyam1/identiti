# Identiti — environment variables
# Copy to .env in development. .env is gitignored.
# Production envs come from secrets manager via Railway, never from .env files.

# --- Server ---
NODE_ENV=development
PORT=3002
LOG_LEVEL=debug
RAIL_VERSION=0.1.0

# --- Database (Supabase, project: identiti, region: af-south-1) ---
# Direct connection (port 5432) for migrations; pooler (port 6543) for the API.
DATABASE_URL=postgresql://postgres:REPLACE_ME@db.REPLACE_ME.supabase.co:5432/postgres

# --- Auth middleware ---
AUTH_HMAC_TOLERANCE_SECONDS=300

# --- Idempotency middleware ---
# Per Rail Contract §6: 24-hour retention.
IDEMPOTENCY_TTL_SECONDS=86400

# --- Phone-record cryptography (Sprint 1) ---
# 32 bytes hex (64 hex chars). Generate with: openssl rand -hex 32
# In production these come from secrets manager — never commit real values.
PHONE_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
PHONE_HASH_SALT=ffeeddccbbaa99887766554433221100ffeeddccbbaa99887766554433221100

# --- Kafka (Sprint 1) ---
# Comma-separated broker list. Empty in dev → falls back to in-memory producer
# (logs warning at startup). Required in production.
KAFKA_BROKERS=
KAFKA_CLIENT_ID=identiti
KAFKA_SSL=false
# Leave KAFKA_SASL_MECHANISM empty to disable SASL.
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# --- JWT signing (Sprint 2) ---
# RS256 keypair for customer tokens (Phase 3) and step-up tokens (Phase 5).
# Production: required. Development/test: leave blank → ephemeral keypair is
# generated at startup (with a warning). Generate with:
#   openssl genrsa -out priv.pem 2048
#   openssl rsa -in priv.pem -pubout -out pub.pem
# Multi-line values: paste literal newlines (Railway supports), or escape as \n.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
JWT_ISSUER=https://api.id.identiti.co.ke

# --- OTP (Sprint 2) ---
# bcrypt cost factor for OTP hashing. Production: 10. Tests use 4 for speed.
OTP_BCRYPT_ROUNDS=10

# --- Phone-token HS256 signing (Sprint 5 / Phase 6) ---
# 32 bytes hex (64 hex chars). Generate with: openssl rand -hex 32
# Used to sign opaque phone-token JWTs apps pass to Todoku. v1.0 single
# master key; v1.1 hardens to per-account-per-audience derived key.
PHONE_TOKEN_SIGNING_KEY=11223344556677889900aabbccddeeff11223344556677889900aabbccddeeff

# --- KYC + IPRS (Sprint 6 / Phase 4) ---
# 32 bytes hex (64 hex chars). Generate with: openssl rand -hex 32
KYC_HASH_SALT=2233445566778899aabbccddeeff00112233445566778899aabbccddeeff0011
# Stub mode wires the in-process IPRS stub; set false in production once
# IPRS Track A access is provisioned (Reboot Pack §7 ID-D-06).
IPRS_STUB_MODE=true

# --- Phase 4+ external dependencies (uncomment as wiring lands) ---
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# IPRS_API_URL=
# IPRS_API_KEY=
